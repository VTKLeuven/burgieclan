# Credentials of the Burgieclan client on the VTK authorization server.
# Create the client at /admin/sso/nieuw on the VTK website; the secret is shown
# only once. The issuer URL itself lives in backend/.env.dist.
FLUXUS_SSO_CLIENT_ID=replaceThisEnvVariable
FLUXUS_SSO_CLIENT_SECRET=replaceThisEnvVariable
