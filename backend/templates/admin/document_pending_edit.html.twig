{% extends '@EasyAdmin/crud/edit.html.twig' %}

{% block main %}
    {# Render the default edit form first #}
    {{ parent() }}

    {# PDF Preview Panel — shown below the edit form #}
    {% set entity = ea.entity %}
    {% set document = entity.instance %}
    {% set filename = document.fileName %}

    {% if filename and filename|lower ends with '.pdf' %}
        {% set previewUrl = path('admin_document_preview', {filename: filename}) %}

        {# Styles live here rather than in style="" attributes: EasyAdmin puts a nonce on
           style-src (its _css_assets.html.twig calls csp_nonce('style')), and a nonce makes
           the browser ignore the 'unsafe-inline' in nelmio_security.yaml — so attribute
           styles are dropped on every admin page. A nonced <style> element is allowed,
           same as the <script nonce> below. Colors use EasyAdmin's own variables so they
           follow dark mode; the Bootstrap --bs-* ones these replaced did not. #}
        <style nonce="{{ csp_nonce('style') }}">
            .pdf-preview-title { color: var(--text-color-light); }
            .pdf-preview-nav { border-bottom: 1px solid var(--border-color); }
            /* Replaces Bootstrap's bg-white, which stays white in dark mode. */
            .pdf-preview-header { background: var(--content-bg); }
            .pdf-page-info {
                color: var(--text-color-light);
                min-width: 100px;
                text-align: center;
            }
            /* Deliberately a shade off the panel behind it, so white PDF pages read as
               pages. --gray-* are fixed palette tokens rather than theme-aware ones, so
               the dark variant has to be spelled out. */
            .pdf-pages-container {
                overflow: auto;
                max-height: 70vh;
                padding: 16px;
                background: var(--gray-200);
                text-align: center;
            }
            .ea-dark-scheme .pdf-pages-container { background: var(--gray-950); }
        </style>

        <div class="card mb-4 shadow-sm">
            <div class="card-header d-flex align-items-center justify-content-between py-2 pdf-preview-header">
                <span class="small fw-semibold pdf-preview-title">
                    <i class="fa-solid fa-file-pdf text-danger me-1"></i> Document Preview
                </span>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="toggle-edit-preview">
                    <i class="fa-solid fa-chevron-up" id="toggle-edit-preview-icon"></i>
                    <span class="small ms-1">Hide</span>
                </button>
            </div>
            <div id="pdf-edit-preview-container" data-pdf-url="{{ previewUrl }}">
                {# Navigation bar #}
                <div class="d-flex align-items-center justify-content-center gap-3 py-2 pdf-preview-nav">
                    <button type="button" class="btn btn-sm btn-outline-secondary pdf-prev-btn" disabled>
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <span class="small fw-medium pdf-page-info">
                        Loading...
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-secondary pdf-next-btn" disabled>
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>

                {# PDF canvas container #}
                <div class="pdf-pages-container">
                    <div class="text-center py-4 text-muted pdf-loading">
                        <i class="fa-solid fa-spinner fa-spin me-2"></i>Loading PDF...
                    </div>
                </div>
            </div>
        </div>

        <script nonce="{{ csp_nonce('script') }}">
        (function() {
            var container = document.getElementById('pdf-edit-preview-container');
            var toggleBtn = document.getElementById('toggle-edit-preview');
            var toggleIcon = document.getElementById('toggle-edit-preview-icon');

            if (toggleBtn) {
                toggleBtn.addEventListener('click', function() {
                    if (container.style.display === 'none') {
                        container.style.display = '';
                        toggleIcon.classList.remove('fa-chevron-down');
                        toggleIcon.classList.add('fa-chevron-up');
                        toggleBtn.querySelector('span').textContent = 'Hide';
                    } else {
                        container.style.display = 'none';
                        toggleIcon.classList.remove('fa-chevron-up');
                        toggleIcon.classList.add('fa-chevron-down');
                        toggleBtn.querySelector('span').textContent = 'Show';
                    }
                });
            }

            var pdfUrl = container.dataset.pdfUrl;
            var pagesContainer = container.querySelector('.pdf-pages-container');
            var loadingEl = container.querySelector('.pdf-loading');
            var pageInfo = container.querySelector('.pdf-page-info');
            var prevBtn = container.querySelector('.pdf-prev-btn');
            var nextBtn = container.querySelector('.pdf-next-btn');

            import('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.9.155/pdf.min.mjs').then(function(pdfjsMod) {
                pdfjsMod.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.9.155/pdf.worker.min.mjs';

                pdfjsMod.getDocument(pdfUrl).promise.then(function(pdf) {
                    if (loadingEl) loadingEl.remove();

                    var totalPages = pdf.numPages;
                    var currentPage = 1;

                    function showPage(num) {
                        currentPage = num;
                        pageInfo.textContent = 'Page ' + num + ' of ' + totalPages;
                        prevBtn.disabled = (num <= 1);
                        nextBtn.disabled = (num >= totalPages);

                        var oldCanvas = pagesContainer.querySelector('canvas');
                        if (oldCanvas) oldCanvas.remove();

                        setTimeout(function() {
                            var availableWidth = pagesContainer.clientWidth - 32;
                            if (availableWidth < 100) availableWidth = 800;

                            pdf.getPage(num).then(function(page) {
                                var defaultViewport = page.getViewport({ scale: 1 });
                                var scale = availableWidth / defaultViewport.width;
                                var viewport = page.getViewport({ scale: scale });

                                var canvas = document.createElement('canvas');
                                canvas.style.display = 'block';
                                canvas.style.margin = '0 auto';
                                canvas.style.background = '#fff';
                                canvas.style.boxShadow = '0 1px 4px rgba(0,0,0,0.12)';
                                canvas.height = viewport.height;
                                canvas.width = viewport.width;

                                pagesContainer.appendChild(canvas);
                                page.render({ canvasContext: canvas.getContext('2d'), viewport: viewport });
                            });
                        }, 50);
                    }

                    prevBtn.addEventListener('click', function() {
                        if (currentPage > 1) showPage(currentPage - 1);
                    });
                    nextBtn.addEventListener('click', function() {
                        if (currentPage < totalPages) showPage(currentPage + 1);
                    });

                    showPage(1);
                }).catch(function(err) {
                    if (loadingEl) loadingEl.remove();
                    pageInfo.textContent = 'Failed to load';
                    pageInfo.classList.add('text-danger');
                });
            });
        })();
        </script>
    {% endif %}
{% endblock %}
