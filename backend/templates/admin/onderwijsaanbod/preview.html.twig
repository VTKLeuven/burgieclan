{% extends '@EasyAdmin/page/content.html.twig' %}

{% macro moduleNode(m, existingModuleKulIds, existingCourseCodes) %}
    {% import _self as tree %}
    <li>
        <strong>{{ m.name }}</strong>
        {% if existingModuleKulIds[m.kulId] is defined %}
            <span class="badge badge-secondary">update</span>
        {% else %}
            <span class="badge badge-success">new</span>
        {% endif %}
        {% if m.isElective %}<span class="badge badge-info">keuze</span>{% endif %}
        {% if m.courses is not empty or m.children is not empty %}
            <ul>
                {% for c in m.courses %}
                    <li>
                        <code>{{ c.code }}</code> {{ c.name }}
                        <span class="text-muted">
                            ({{ c.credits is not null ? c.credits ~ ' sp' : '– sp' }}, {{ c.language }}{{ c.semesters is not empty ? ', ' ~ c.semesters|join('+') }})
                        </span>
                        {% if existingCourseCodes[c.code] is defined %}
                            <span class="badge badge-secondary">update</span>
                        {% else %}
                            <span class="badge badge-success">new</span>
                        {% endif %}
                        {% if not c.mandatory %}<span class="badge badge-light">optional</span>{% endif %}
                    </li>
                {% endfor %}
                {% for child in m.children %}
                    {{ tree.moduleNode(child, existingModuleKulIds, existingCourseCodes) }}
                {% endfor %}
            </ul>
        {% endif %}
    </li>
{% endmacro %}

{% import _self as tree %}

{% block content_title %}Preview import — {{ program.name }}{% endblock %}

{% block main %}
    <p>
        <code>{{ program.kulId }}</code>
        {% if existingProgram %}
            <span class="badge badge-secondary">existing program — will be updated</span>
        {% else %}
            <span class="badge badge-success">new program</span>
        {% endif %}
    </p>

            {# ---- Structure controls: pick folders to flatten or regroup by semester ---- #}
            <form method="post" action="{{ path('admin_onderwijsaanbod_import_preview') }}" class="mb-3">
                <input type="hidden" name="configured" value="1">
                <input type="hidden" name="programId" value="{{ options.programId }}">
                <input type="hidden" name="lang" value="{{ options.lang }}">
                <input type="hidden" name="enrich" value="{{ options.enrich ? '1' : '0' }}">

                <div class="bc-scroll-360">
                    <table class="table datagrid">
                        <thead>
                            <tr>
                                <th>Folder</th>
                                <th class="text-center" title="Skip this folder; its courses attach to the parent">Flatten</th>
                                <th class="text-center" title="Replace this folder's subgroups with Semester 1..N folders">By semester</th>
                                <th class="text-center" title="Top-level only: make this folder disappear and pool its courses into one shared set of Semester 1..N folders. Elective options inside it become a folder per semester.">Dissolve to semesters</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for g in groups %}
                                <tr>
                                    <td class="bc-tree-cell" data-depth="{{ min(g.depth, 9) }}">{{ g.name }}</td>
                                    <td class="text-center">
                                        <input type="checkbox" name="flatten[]" value="{{ g.kulId }}"
                                               {{ (g.kulId in options.flatten or g.name in options.flatten) ? 'checked' : '' }}>
                                    </td>
                                    <td class="text-center">
                                        <input type="checkbox" name="semester[]" value="{{ g.kulId }}"
                                               {{ (g.kulId in options.semester or g.name in options.semester) ? 'checked' : '' }}>
                                    </td>
                                    <td class="text-center">
                                        {# Only top-level groups can dissolve: pulling a nested group's
                                           courses up to the programme root would empty a parent the
                                           admin never selected. #}
                                        {% if g.depth == 0 %}
                                            <input type="checkbox" name="semesterFlat[]" value="{{ g.kulId }}"
                                                   {{ (g.kulId in options.semesterFlat or g.name in options.semesterFlat) ? 'checked' : '' }}>
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="merge" name="merge" value="1" {{ options.merge ? 'checked' : '' }}>
                    <label class="form-check-label" for="merge">Merge a folder that contains only a single sub-folder</label>
                </div>

                <div class="form-group mt-2">
                    <label class="form-label d-block">Keuzepakketten</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="electiveGroupingPerTrack"
                               name="electiveGrouping" value="perTrack"
                               {{ options.electiveGrouping == 'perTrack' ? 'checked' : '' }}>
                        <label class="form-check-label" for="electiveGroupingPerTrack">
                            One “Keuzepakketten” folder <strong>per afstudeerrichting</strong>
                            <small class="text-muted d-block">Keeps which packages a student may actually choose.</small>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="electiveGroupingProgramme"
                               name="electiveGrouping" value="programme"
                               {{ options.electiveGrouping == 'programme' ? 'checked' : '' }}>
                        <label class="form-check-label" for="electiveGroupingProgramme">
                            One folder for the <strong>whole programme</strong>
                            <small class="text-muted d-block">Tidier tree, but loses which track offers what.</small>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="electiveGroupingNone"
                               name="electiveGrouping" value="none"
                               {{ options.electiveGrouping == 'none' ? 'checked' : '' }}>
                        <label class="form-check-label" for="electiveGroupingNone">
                            <strong>Leave them</strong> where KU Leuven puts them
                        </label>
                    </div>
                    <small class="form-text text-muted">
                        KU Leuven repeats the same package under every afstudeerrichting that offers it,
                        so both grouping modes deduplicate them into a single shared module.
                    </small>
                </div>

                <button type="submit" class="btn btn-secondary btn-sm mt-2">Update preview</button>
            </form>

            {# ---- Result summary + tree ---- #}
            <ul class="list-inline text-muted">
                <li class="list-inline-item">Modules: <strong>{{ summary.modulesCreated }}</strong> new, <strong>{{ summary.modulesUpdated }}</strong> update{% if summary.modulesDetached %}, <strong>{{ summary.modulesDetached }}</strong> detached{% endif %}</li>
                <li class="list-inline-item">Courses: <strong>{{ summary.coursesCreated }}</strong> new, <strong>{{ summary.coursesUpdated }}</strong> update</li>
                <li class="list-inline-item">Enriched: <strong>{{ summary.enrichedCourses }}</strong></li>
            </ul>

            <div class="alert alert-info">Nothing has been written yet. Review the tree below and confirm to import.</div>

            {% if summary.warnings is not empty %}
                {# Mixed bag: courses that left the curriculum AND folders detached by a changed
                   structural option. Labelling the count "course(s)" mis-described the latter. #}
                <div class="alert alert-warning">
                    <strong>{{ summary.warnings|length }} thing(s) worth checking.</strong>
                    Nothing is deleted here: courses keep their comments and documents, and detached
                    folders keep their courses and position. Clean up in the tree editor if you want
                    them gone.
                    <ul class="mb-0 mt-2">
                        {% for warning in summary.warnings %}<li>{{ warning }}</li>{% endfor %}
                    </ul>
                </div>
            {% endif %}

            {# ---- What this import would overwrite on courses that already exist ---- #}
            {% if summary.courseChanges is not empty %}
                <div class="content-panel">
                    <div class="content-panel-header">
                        <div class="content-panel-title">
                            Existing courses that would change
                            <span class="badge badge-warning">{{ summary.courseChanges|length }}</span>
                        </div>
                    </div>
                    <div class="content-panel-body">
                        <p class="text-muted small">
                            These fields are also editable in the admin, so anything changed by hand will be
                            replaced by the KU Leuven value below.
                        </p>
                        <div class="table-responsive">
                            <table class="table datagrid">
                                <thead>
                                    <tr>
                                        <th>Course</th>
                                        <th>Field</th>
                                        <th>Current</th>
                                        <th>After import</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for change in summary.courseChanges %}
                                        <tr>
                                            <td><code>{{ change.code }}</code> {{ change.course }}</td>
                                            <td>{{ change.field }}</td>
                                            <td class="text-muted">{{ change.from }}</td>
                                            <td><strong>{{ change.to }}</strong></td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="onderwijsaanbod-tree mb-4">
                <ul>
                    {% for module in program.modules %}
                        {{ tree.moduleNode(module, existingModuleKulIds, existingCourseCodes) }}
                    {% endfor %}
                </ul>
            </div>

            {# ---- Confirm: carry the exact applied options through to commit ---- #}
            <form method="post" action="{{ path('admin_onderwijsaanbod_import_commit') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('onderwijsaanbod_import') }}">
                <input type="hidden" name="configured" value="1">
                <input type="hidden" name="programId" value="{{ options.programId }}">
                <input type="hidden" name="lang" value="{{ options.lang }}">
                <input type="hidden" name="enrich" value="{{ options.enrich ? '1' : '0' }}">
                <input type="hidden" name="merge" value="{{ options.merge ? '1' : '0' }}">
                <input type="hidden" name="electiveGrouping" value="{{ options.electiveGrouping }}">
                {# Every structural option has to be replayed here. The commit posts a fresh request,
                   so anything missing silently reverts to its default and the import writes a tree
                   that does not match the preview above. #}
                {% for id in options.flatten %}<input type="hidden" name="flatten[]" value="{{ id }}">{% endfor %}
                {% for id in options.semester %}<input type="hidden" name="semester[]" value="{{ id }}">{% endfor %}
                {% for id in options.semesterFlat %}<input type="hidden" name="semesterFlat[]" value="{{ id }}">{% endfor %}

                <button type="submit" class="btn btn-primary">Confirm import</button>
                <a href="{{ path('admin_onderwijsaanbod_import') }}" class="btn btn-secondary">Back</a>
            </form>
{% endblock %}
