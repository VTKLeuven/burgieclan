{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{# @var field \EasyCorp\Bundle\EasyAdminBundle\Dto\FieldDto #}
{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}

{% set filename = field.value %}
{% set entityId = entity.primaryKeyValue %}
{# Which extensions count lives in App\Constants\PreviewableFile, not here. #}
{% set kind = preview_kind(filename) %}

{% if filename %}
    <div class="d-inline-flex align-items-center gap-1">
        {% if kind %}
            <button type="button"
                    class="btn btn-xs btn-outline-primary d-inline-flex align-items-center py-0 px-2 toggle-pdf-btn"
                    data-entity-id="{{ entityId }}"
                    data-file-type="{{ kind }}"
                    data-pdf-url="{{ path('admin_document_preview', {filename: filename}) }}"
                    title="Toggle Full Row Preview">
                <i class="fa-solid fa-chevron-down" id="chevron-{{ entityId }}"></i>
            </button>
        {% endif %}

        <a href="{{ path('admin_document_preview', {filename: filename}) }}"
           target="_blank"
           rel="noopener noreferrer"
           class="btn btn-xs btn-outline-secondary d-inline-flex align-items-center py-0 px-2"
           title="{{ kind ? 'Open document in new tab' : 'Download document' }}">
            <i class="fa-solid {{ kind ? 'fa-arrow-up-right-from-square' : 'fa-download' }}"></i>
        </a>
    </div>
{% else %}
    <span class="text-muted small">No file</span>
{% endif %}

<script nonce="{{ csp_nonce('script') }}">
if (typeof window.pdfPreviewListenerAdded === 'undefined') {
    window.pdfPreviewListenerAdded = true;

    function renderPdfPage(pdf, pageNum, container) {
        // Defer with setTimeout so the newly inserted table row has been laid out
        setTimeout(function() {
            var availableWidth = container.clientWidth - 32;
            if (availableWidth < 100) availableWidth = 800; // fallback

            pdf.getPage(pageNum).then(function(page) {
                var defaultViewport = page.getViewport({ scale: 1 });
                var scale = availableWidth / defaultViewport.width;
                var viewport = page.getViewport({ scale: scale });

                var canvas = document.createElement('canvas');
                canvas.className = 'bc-pdf-canvas';
                var ctx = canvas.getContext('2d');
                canvas.height = viewport.height;
                canvas.width = viewport.width;

                container.appendChild(canvas);

                page.render({ canvasContext: ctx, viewport: viewport });
            });
        }, 50);
    }

    function loadImage(imgUrl, container) {
        var imgWrapper = document.createElement('div');
        imgWrapper.className = 'bc-preview-scroll';

        var img = document.createElement('img');
        img.src = imgUrl;
        img.className = 'bc-preview-image';

        imgWrapper.appendChild(img);
        container.appendChild(imgWrapper);
    }

    function loadText(textUrl, container) {
        var wrapper = document.createElement('div');
        wrapper.className = 'bc-preview-scroll';

        var pre = document.createElement('pre');
        pre.className = 'bc-preview-text';
        pre.textContent = 'Loading...';
        wrapper.appendChild(pre);
        container.appendChild(wrapper);

        fetch(textUrl, { credentials: 'same-origin' })
            .then(function(r) { return r.ok ? r.text() : Promise.reject(r.status); })
            .then(function(body) {
                // textContent, never innerHTML: this is an uploaded file being shown back
                // to a moderator on the same origin as the admin panel.
                pre.textContent = body;
            })
            .catch(function() { pre.textContent = 'Failed to load file.'; });
    }

    function loadPdf(pdfUrl, container, entityId) {
        var loading = document.createElement('div');
        loading.className = 'text-center py-4 text-muted';
        loading.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Loading PDF...';
        container.appendChild(loading);

        import('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.9.155/pdf.min.mjs').then(function(pdfjsMod) {
            var pdfjsLib = pdfjsMod;
            pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.9.155/pdf.worker.min.mjs';

            pdfjsLib.getDocument(pdfUrl).promise.then(function(pdf) {
                container.removeChild(loading);

                var totalPages = pdf.numPages;
                var currentPage = 1;

                // Navigation bar — matches EasyAdmin's muted toolbar style
                var navBar = document.createElement('div');
                navBar.className = 'd-flex align-items-center justify-content-center gap-3 py-2 bc-preview-navbar';

                var prevBtn = document.createElement('button');
                prevBtn.type = 'button';
                prevBtn.className = 'btn btn-sm btn-outline-secondary';
                prevBtn.innerHTML = '<i class="fa-solid fa-chevron-left"></i>';

                var pageInfo = document.createElement('span');
                pageInfo.className = 'small fw-medium bc-preview-pageinfo';

                var nextBtn = document.createElement('button');
                nextBtn.type = 'button';
                nextBtn.className = 'btn btn-sm btn-outline-secondary';
                nextBtn.innerHTML = '<i class="fa-solid fa-chevron-right"></i>';

                navBar.appendChild(prevBtn);
                navBar.appendChild(pageInfo);
                navBar.appendChild(nextBtn);
                container.appendChild(navBar);

                // PDF page container
                var pagesContainer = document.createElement('div');
                pagesContainer.className = 'bc-preview-scroll';
                container.appendChild(pagesContainer);

                function showPage(num) {
                    currentPage = num;
                    pageInfo.textContent = 'Page ' + num + ' of ' + totalPages;
                    prevBtn.disabled = (num <= 1);
                    nextBtn.disabled = (num >= totalPages);
                    pagesContainer.innerHTML = '';
                    renderPdfPage(pdf, num, pagesContainer);
                }

                prevBtn.addEventListener('click', function() {
                    if (currentPage > 1) showPage(currentPage - 1);
                });
                nextBtn.addEventListener('click', function() {
                    if (currentPage < totalPages) showPage(currentPage + 1);
                });

                showPage(1);
            }).catch(function(err) {
                container.removeChild(loading);
                var errDiv = document.createElement('div');
                errDiv.className = 'text-center py-4 text-danger';
                errDiv.innerHTML = '<i class="fa-solid fa-triangle-exclamation me-2"></i>Failed to load PDF: ' + err.message;
                container.appendChild(errDiv);
            });
        });
    }

    document.addEventListener('click', function(evt) {
        var btn = evt.target.closest('.toggle-pdf-btn');
        if (!btn) return;

        evt.preventDefault();
        var entityId = btn.getAttribute('data-entity-id');
        var pdfUrl = btn.getAttribute('data-pdf-url');
        var fileType = btn.getAttribute('data-file-type') || 'pdf';
        var tr = btn.closest('tr');
        var chevron = document.getElementById('chevron-' + entityId);

        var existingRow = document.getElementById('preview-row-' + entityId);
        if (existingRow) {
            if (existingRow.style.display === 'none') {
                existingRow.style.display = 'table-row';
                if (chevron) {
                    chevron.classList.remove('fa-chevron-down');
                    chevron.classList.add('fa-chevron-up');
                }
            } else {
                existingRow.style.display = 'none';
                if (chevron) {
                    chevron.classList.remove('fa-chevron-up');
                    chevron.classList.add('fa-chevron-down');
                }
            }
            return;
        }

        if (!tr) return;

        var colCount = tr.children.length;
        var newRow = document.createElement('tr');
        newRow.id = 'preview-row-' + entityId;

        var td = document.createElement('td');
        td.colSpan = colCount;
        td.className = 'bc-preview-cell';

        // Minimal wrapper — no card, just a clean bordered container
        var wrapper = document.createElement('div');
        wrapper.className = 'bc-preview-wrapper';

        // Header with title and close button
        var header = document.createElement('div');
        header.className = 'd-flex justify-content-between align-items-center px-3 py-2 bc-preview-header';

        var titleSpan = document.createElement('span');
        titleSpan.className = 'small fw-semibold bc-preview-title';
        var icons = {
            image: '<i class="fa-solid fa-file-image text-primary me-1"></i> Preview',
            text: '<i class="fa-solid fa-file-lines text-secondary me-1"></i> Preview',
            pdf: '<i class="fa-solid fa-file-pdf text-danger me-1"></i> Preview'
        };
        titleSpan.innerHTML = icons[fileType] || icons.pdf;

        var closeBtn = document.createElement('button');
        closeBtn.type = 'button';
        closeBtn.className = 'btn-close btn-sm';
        closeBtn.setAttribute('aria-label', 'Close');
        closeBtn.addEventListener('click', function() {
            newRow.style.display = 'none';
            if (chevron) {
                chevron.classList.remove('fa-chevron-up');
                chevron.classList.add('fa-chevron-down');
            }
        });

        header.appendChild(titleSpan);
        header.appendChild(closeBtn);

        var body = document.createElement('div');

        wrapper.appendChild(header);
        wrapper.appendChild(body);
        td.appendChild(wrapper);
        newRow.appendChild(td);

        tr.parentNode.insertBefore(newRow, tr.nextSibling);
        if (chevron) {
            chevron.classList.remove('fa-chevron-down');
            chevron.classList.add('fa-chevron-up');
        }

        if (fileType === 'image') {
            loadImage(pdfUrl, body);
        } else if (fileType === 'text') {
            loadText(pdfUrl, body);
        } else {
            loadPdf(pdfUrl, body, entityId);
        }
    });
}
</script>
