{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{# @var field \EasyCorp\Bundle\EasyAdminBundle\Dto\FieldDto #}
{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}

{% set filename = field.value %}
{% set entityId = entity.primaryKeyValue %}

{% if filename %}
    <div class="d-inline-flex flex-column align-items-start gap-1">
        <div class="d-flex align-items-center gap-2">
            <span class="fw-medium text-break">{{ filename }}</span>

            {% if filename|lower ends with '.pdf' %}
                <button type="button"
                        class="btn btn-xs btn-outline-primary d-inline-flex align-items-center gap-1 py-0 px-2"
                        data-bs-toggle="collapse"
                        data-bs-target="#preview-collapse-{{ entityId }}"
                        aria-expanded="false"
                        aria-controls="preview-collapse-{{ entityId }}"
                        title="Toggle Inline PDF Preview">
                    <i class="fa-solid fa-chevron-down"></i>
                    <span class="small">Preview</span>
                </button>
            {% endif %}
        </div>

        {% if filename|lower ends with '.pdf' %}
            <div class="collapse mt-2 w-100" id="preview-collapse-{{ entityId }}" style="min-width: 550px;">
                <div class="card card-body p-1 shadow-sm bg-light">
                    <iframe src="{{ path('document_download', {filename: filename}) }}"
                            style="width: 100%; height: 500px; border: none; border-radius: 4px;"
                            loading="lazy">
                    </iframe>
                </div>
            </div>
        {% endif %}
    </div>
{% else %}
    <span class="text-muted small">No file</span>
{% endif %}
