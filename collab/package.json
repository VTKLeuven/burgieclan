{
  "name": "burgieclan-collab",
  "version": "0.1.0",
  "private": true,
  "description": "Live collaborative editing server (Hocuspocus) for Burgieclan",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@hocuspocus/server": "^4.7.0",
    "@hocuspocus/transformer": "^4.7.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "jose": "^6.2.12",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.7.0",
    "@types/node": "24.13.6",
    "typescript": "6.0.3"
  }
}
