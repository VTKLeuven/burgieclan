#!/bin/sh
#
# Git commit-msg hook that enforces Conventional Commits
# https://www.conventionalcommits.org/
#
# Format: <type>[(scope)][!]: <description>
#

COMMIT_MSG_FILE=$1

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# The subject is the first line that is neither blank nor a comment. Reading the raw
# file would trip over the instructions git appends when the message is written in an
# editor rather than passed with -m.
SUBJECT=$(grep -v '^#' "$COMMIT_MSG_FILE" | grep -v '^[[:space:]]*$' | head -n 1)

# Merges, reverts and fixups are generated by git itself and cannot be reworded, so
# they are exempt rather than blocked.
case "$SUBJECT" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *)
        exit 0
        ;;
esac

TYPES="build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test"
PATTERN="^($TYPES)(\([a-zA-Z0-9._/-]+\))?!?: .+"

if ! echo "$SUBJECT" | grep -qE "$PATTERN"; then
    echo "${RED}❌ ERROR: Commit message must follow Conventional Commits${NC}"
    echo ""
    echo "Your commit message:"
    echo "  $SUBJECT"
    echo ""
    echo "Expected format:"
    echo "  <type>[(scope)][!]: <description>"
    echo ""
    echo "Allowed types:"
    echo "  build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test"
    echo ""
    echo "Valid examples:"
    echo "  ✓ feat: add MATLAB file uploads"
    echo "  ✓ fix(frontend): resolve favorites toggle on the courses page"
    echo "  ✓ chore: update dependency lucide-react to v1.33.0"
    echo "  ✓ feat(api)!: drop the legacy document endpoint"
    echo ""
    echo "Invalid examples:"
    echo "  ✗ add new feature          (no type)"
    echo "  ✗ Feat: add new feature    (type must be lowercase)"
    echo "  ✗ feat add new feature     (missing colon)"
    echo "  ✗ feat:                    (missing description)"
    echo ""
    echo "${YELLOW}Use an exclamation mark before the colon to flag a breaking change.${NC}"
    echo ""
    echo "${YELLOW}To commit anyway (not recommended), use:${NC}"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

exit 0
