/.idea

.env

# Python artifacts
__pycache__/
*.py[cod]

# Scratch
2026-*.txt
.~lock.*#

# Migration working data: wiki dumps, extracted comments, reports, generated SQL.
# This is student-written content and course data, not source code, and it is
# regenerable from scripts/wiki_migration/. Ignored as a whole rather than by
# pattern: a blocklist only covers the files someone remembered to add, and
# migration_data/review_batches/ was already slipping through.
migration_data/
scripts/wiki_migration/__pycache__/

# Exported conversation transcripts (`/export`). They quote whatever was on screen,
# including credentials typed or printed during the session, and are not source code.
migrate-wiki.txt
*-conversation.txt
